{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Python AI packages",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/ai-module" },
      "problemMatcher": []
    },
    {
      "label": "Install backend",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Install frontend",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install all",
      "dependsOn": ["Install Python AI packages", "Install backend", "Install frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "AI service",
      "type": "shell",
      "command": "python -m uvicorn app:app --host 127.0.0.1 --port 43122",
      "options": {
        "cwd": "${workspaceFolder}/ai-module",
        "env": { "PYTHONPATH": "${workspaceFolder}/ai-module" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend API",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start CarbonCreditFarm",
      "dependsOn": ["AI service", "Backend API", "Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
